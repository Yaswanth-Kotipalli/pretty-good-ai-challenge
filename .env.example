# Copy to .env and fill in. NEVER commit .env.
#
# --- Twilio: PSTN carrier + call recording (no conversational logic lives here) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your single Twilio phone number in E.164, used for ALL test calls, e.g. +13334445555
TWILIO_CALLER_NUMBER=

# --- LiveKit Cloud: runs the voice agent in pipeline mode ---
# From https://cloud.livekit.io -> your project -> Settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Your project's SIP endpoint host from LiveKit Cloud -> Telephony -> SIP,
# e.g. abc123.sip.livekit.cloud (each project gets its own -- the generic
# sip.livekit.cloud host will NOT resolve)
SIP_HOST=
# Inbound SIP trunk auth, only if your trunk requires it
SIP_TRUNK_USER=
SIP_TRUNK_PASSWORD=

# --- Pipeline providers: separate STT / LLM / TTS (no realtime models) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Public HTTPS base URL of the Twilio webhook server (your ngrok URL), no trailing slash
# e.g. https://abcd-1-2-3-4.ngrok-free.app
PUBLIC_BASE_URL=

# --- Optional tuning ---
LLM_MODEL=gpt-4o-mini
ANALYZER_MODEL=gpt-4o-mini
# Provider-specific TTS voice id; empty = plugin default
TTS_VOICE=
